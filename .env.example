# ── Discord Webhooks ─────────────────────────────────────────────────────────
DISCORD_CONTACT_WEBHOOK_URL=votre-webhook-discord-contact
DISCORD_ADMIN_WEBHOOK_URL=votre-webhook-discord-admin

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=votre-cle-site-turnstile
TURNSTILE_SECRET_KEY=votre-cle-secrete-turnstile

# ── Umami Analytics ──────────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=votre-id-umami
NEXT_PUBLIC_UMAMI_URL=https://umami.votre-domaine.com

# ── Base de données SQLite ───────────────────────────────────────────────────
DATABASE_URL="file:./SQLite.db"

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=votre-cle-api-youtube

# ── OpenAI API ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=votre-cle-api-openai

# ── NextAuth v5 (Auth.js) ────────────────────────────────────────────────────
AUTH_SECRET=votre-secret-aleatoire-32-chars-min

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=votre-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-google-client-secret
