# ── Discord Webhook ──────────────────────────────────────────────────────────
DISCORD_CONTACT_WEBHOOK_URL=votre-webhook-discord-ici
DISCORD_ADMIN_WEBHOOK_URL=votre-webhook-discord-ici

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=votre-clé-site-turnstile-ici
TURNSTILE_SECRET_KEY=votre-clé-secrète-turnstile-ici
  
# ── Umami Analytics ──────────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=votre-id-umami-ici

# ── Base de données Sqlite ───────────────────────────────────────────────────
DATABASE_URL="file:./SQLite.db"

# ── YouTube API Key ─────────────────────────────────────────────────────────
YOUTUBE_API_KEY=votre-clé-api-youtube-ici

# ── NextAuth v5 (Auth.js) ────────────────────────────────────────────────────
AUTH_SECRET=votre-secret-aleatoire-ici

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=votre-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-google-client-secret