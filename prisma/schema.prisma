generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Saga {
  id           String   @id @default(cuid())
  jikanId      Int      @unique
  key          String   @unique
  type         String
  label        String
  synopsisFr   String
  image        String
  status       String
  score        Float?
  creator      String
  total        Int?
  year         Int?
  lastUpdated  DateTime @default(now())
}