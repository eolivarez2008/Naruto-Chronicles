generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Saga {
  id          String   @id @default(cuid())
  tenraiId     Int?
  type        String
  label       String
  synopsisFr  String
  image       String
  status      String
  score       Float?
  creator     String
  episodes    Int?
  chapters    Int?
  volumes     Int?
  year        Int?
  lastUpdated DateTime @default(now())

  @@unique([tenraiId, type])
  @@index([type])
}

model Character {
  id             Int      @id
  name           String
  normalizedName String
  image          String?
  sex            String
  birthdate      String
  age            String
  height         String
  rank           String
  natureType     String
  jutsu          String
  family         String
  debut          String
  popularity     Int
  lastUpdated    DateTime

  @@index([normalizedName])
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  avatarSnapshot String?
  image          String?
  consentGiven   Boolean    @default(false)
  consentAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts   Account[]
  sessions   Session[]
  videoLikes VideoLike[]
  tierLists      TierList[]
  tierListLikes  TierListLike[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Video {
  id           String   @id
  title        String
  thumbnail    String
  channelTitle String
  publishedAt  DateTime
  category     String
  keyword      String
  viewCount    BigInt   @default(0)
  likesCount   Int      @default(0)
  fetchedAt    DateTime @default(now())
  lastUpdated  DateTime @default(now())

  likes VideoLike[]

  @@index([category])
  @@index([publishedAt])
  @@index([likesCount])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String?
  ipHash    String
  createdAt DateTime @default(now())

  video Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([videoId, userId])
  @@unique([videoId, ipHash])
  @@index([userId])
  @@index([videoId])
}

model TierList {
  id          String   @id @default(cuid())
  title       String
  isPublic    Boolean  @default(true)

  tiersData   String

  packUsed    String   @default("all")

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes       TierListLike[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@index([createdAt])
}

model TierListLike {
  id         String   @id @default(cuid())
  tierListId String
  userId     String
  createdAt  DateTime @default(now())

  tierList   TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tierListId, userId])
  @@index([userId])
  @@index([tierListId])
}

model StoryArc {
  id            String   @id @default(cuid())
  slug          String   @unique

  order         Int
  sagaKey       String

  title         String
  summary       String
  content       String   @default("")

  titleFr     String?
  summaryFr   String?
  contentFr   String?

  fetchedAt     DateTime @default(now())
  lastUpdated   DateTime @default(now()) @updatedAt

  @@index([sagaKey, order])
}
