generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Saga {
  id           String   @id @default(cuid())
  jikanId      Int      @unique
  key          String   @unique
  type         String
  label        String
  synopsisFr   String
  image        String
  status       String
  score        Float?
  creator      String
  total        Int?
  year         Int?
  lastUpdated  DateTime @default(now())
}

model Character {
  id             Int      @id
  name           String
  normalizedName String
  image          String?
  sex            String
  birthdate      String
  age            String
  height         String
  rank           String 
  natureType     String 
  jutsu          String 
  family         String   
  debut          String   
  popularity     Int
  lastUpdated    DateTime

  @@index([normalizedName])
}

model Video {
  id           String      @id              // YouTube videoId (ex: "dQw4w9WgXcQ")
  title        String
  thumbnail    String
  channelTitle String
  publishedAt  DateTime
  category     String                       // "edit" | "theorie" | "react" | "fanart" | "ost"
  keyword      String                       // mot-clé utilisé pour la récupérer
  viewCount    BigInt      @default(0)
  likesCount   Int         @default(0)      // likes internes (communauté du site)
  fetchedAt    DateTime    @default(now())
  lastUpdated  DateTime    @default(now())

  likes        VideoLike[]

  @@index([category])
  @@index([publishedAt])
  @@index([likesCount])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String?                         // nullable — placeholder pour le futur auth
  ipHash    String                          // fingerprint IP (actif tant que userId est null)
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // unicité : un like par (video + ip) ou (video + user) selon le contexte
  @@unique([videoId, ipHash])
  @@index([videoId])
}
